{
    "inlineSourceMap": true,
    "compilerOptions": {
        // Previously inherited from `@tsconfig/svelte`, which went with
        // Svelte. Stated here rather than through a base preset named after a
        // framework this project no longer uses. `verbatimModuleSyntax` and
        // the source-map setting were already declared below.
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "target": "ES2018",
        "allowJs": true,
        "noImplicitAny": true,
        "moduleResolution": "bundler",
        "types": ["node"],
        // "importsNotUsedAsValues": "error",
        "importHelpers": false,
        "alwaysStrict": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noImplicitOverride": true,
        "noEmit": true,
        "lib": ["es2018", "DOM", "ES5", "ES6", "ES7", "es2019.array", "ES2021.WeakRef", "ES2020.BigInt", "ESNext.Intl"],
        "strictBindCallApply": true,
        "strictFunctionTypes": true,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["**/*.ts", "test/**/*.test.ts", "**/*.unit.spec.ts"],
    "exclude": [
        "pouchdb-browser-webpack",
        "utils",
        "src/apps",
        "src/**/*.test.ts",
        "**/_test/**",
        "test/browser-apps",
        "test/styles/*.deno.ts",
        "utilsdeno"
    ]
}
